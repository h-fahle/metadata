{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "cli:default",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bin/magick",
          "sidecar": true,
          "args": [
            { "validator": ".+" },
            "-thumbnail",
            "130x>",
            { "validator": ".+" }
          ]
        }
      ]
    }
  ]
}