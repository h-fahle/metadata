{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-hello-world",
  "mainBinaryName": "tauri-hello-world",
  "version": "0.1.0",
  "identifier": "de.hfahle.exifeditor",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": null,
    "beforeBuildCommand": null,
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Metadaten Editor [V. 4.0b]",
        "width": 780,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "resources": [
      ".ExifTool_config"
    ],
    "icon": [
      "icons/metadata.png"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
